---
import '@/styles/global.css'
import Footer from '../components/Footer.astro'

const { title = "Villas Izu Garden, totalmente equipadas - 15 minutos de la Fortuna de San Carlos." } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon2.svg" />
		<link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
<script src="https://unpkg.com/aos@next/dist/aos.js" defer onload="AOS.init({ once: true });"></script>

		<title>{title}</title>
	</head>
	<body>
		<header class="fixed w-full bg-[#FFF0DA]/90 backdrop-blur-sm z-50 shadow-sm">
			<div class="container mx-auto px-4 py-4 flex justify-between items-center">
			  <a href="/" class="text-2xl font-serif font-bold text-[#796446]">
				Villas Izu Garden
			  </a>
			  <nav class="hidden md:flex space-x-8">
				<a href="#about" class="text-[#796446] hover:text-[#C69349] transition-colors">Nosotros</a>
				<a href="#villas" class="text-[#796446] hover:text-[#C69349] transition-colors">Villas</a>
				<a href="#amenities" class="text-[#796446] hover:text-[#C69349] transition-colors">Amenidades</a>
				<a href="#availability" class="text-[#796446] hover:text-[#C69349] transition-colors">Disponibilidad</a>
				<a href="#contact" class="text-[#796446] hover:text-[#C69349] transition-colors">Contacto</a>
			  </nav>
			  <button class="md:hidden text-[#796446]">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
				  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
			  </button>
			</div>
		  </header>
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
