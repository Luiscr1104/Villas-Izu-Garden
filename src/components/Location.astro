<section
  id="location"
  class="py-32 bg-primary-light/20 relative overflow-hidden"
>
  <div class="container mx-auto px-4">
    <!-- Title Section -->
    <div class="text-center mb-24" data-aos="fade-up">
      <h2
        class="text-5xl md:text-6xl font-serif font-bold text-primary-dark mb-6 italic"
      >
        Donde el Viento Susurra
      </h2>
      <p
        class="max-w-2xl mx-auto text-lg md:text-xl text-primary-dark/80 font-light leading-relaxed"
      >
        Ubicados en el epicentro de la serenidad, a las faldas del Volcán
        Arenal, Costa Rica.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <!-- Map Container -->
      <div data-aos="fade-right">
        <div
          class="glass rounded-[60px] shadow-premium overflow-hidden border border-white/40"
        >
          <!-- Map Header -->
          <div class="bg-primary-dark text-primary-light p-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <div class="w-3 h-3 bg-primary rounded-full animate-pulse">
                </div>
                <h3 class="font-serif font-bold text-lg italic">
                  Santuario Izu
                </h3>
              </div>
              <span class="text-xs uppercase tracking-widest opacity-60"
                >La Fortuna, CR</span
              >
            </div>
          </div>

          <!-- Real Map Integration -->
          <div class="relative h-[450px] overflow-hidden">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15705.5147703623!2d-84.66442435!3d10.470891!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa00c8f5f02882f%3A0x6bba3bc3f124c64b!2sLa%20Fortuna%2C%20Alajuela%20Province%2C%20San%20Carlos!5e0!3m2!1sen!2scr!4v1700000000000!5m2!1sen!2scr"
              width="100%"
              height="100%"
              style="border:0; filter: grayscale(1) contrast(1.2) opacity(0.8);"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="hover:filter-none transition-all duration-1000"></iframe>

            <!-- Floating Label Overlay -->
            <div class="absolute bottom-6 left-6 pointer-events-none">
              <div
                class="glass px-4 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest text-primary-dark/60 border border-white/20"
              >
                Ubicación Exacta al Reservar
              </div>
            </div>
          </div>

          <!-- Map Footer -->
          <div class="p-6 bg-white/50 backdrop-blur-md">
            <a
              href="https://maps.google.com/?q=La+Fortuna+San+Carlos+Costa+Rica"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center text-primary-dark font-bold uppercase tracking-widest text-xs hover:text-primary transition-all gap-2"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                ></path></svg
              >
              Explorar en Google Maps
            </a>
          </div>
        </div>
      </div>

      <!-- Location Info -->
      <div data-aos="fade-left" class="space-y-16">
        <div class="space-y-4">
          <h3 class="text-xs font-bold uppercase tracking-[0.3em] text-primary">
            Conectividad
          </h3>
          <p
            class="text-4xl font-serif font-bold text-primary-dark leading-tight italic"
          >
            Cerca de todo, lejos del ruido.
          </p>
        </div>

        <div class="space-y-8">
          {
            [
              { label: "Volcán Arenal", time: "10 min", icon: "🌋" },
              { label: "Aguas Termales", time: "15 min", icon: "♨️" },
              { label: "Catarata La Fortuna", time: "12 min", icon: "💧" },
              { label: "Aeropuerto SJO", time: "3h", icon: "✈️" },
            ].map((item) => (
              <div class="flex items-center justify-between border-b border-primary/10 pb-4 group">
                <div class="flex items-center gap-4">
                  <span class="text-2xl group-hover:scale-125 transition-transform duration-500">
                    {item.icon}
                  </span>
                  <span class="text-xl font-light text-primary-dark/80">
                    {item.label}
                  </span>
                </div>
                <span class="text-primary font-bold tracking-widest uppercase text-sm">
                  {item.time}
                </span>
              </div>
            ))
          }
        </div>

        <div
          class="bg-primary-dark text-primary-light p-10 rounded-[40px] shadow-premium relative group"
        >
          <div
            class="absolute top-0 right-0 w-24 h-24 bg-primary rounded-full blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"
          >
          </div>
          <h4 class="font-serif font-bold text-2xl mb-6 italic">
            Concierge de Traslados
          </h4>
          <p class="font-light text-primary-light/60 mb-8 leading-relaxed">
            Permítenos organizar tu llegada. Contamos con conductores privados
            bilingües y opciones de transporte VIP desde cualquier punto del
            país.
          </p>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 text-primary font-bold uppercase tracking-widest text-xs hover:text-white transition-colors"
          >
            Coordinar Transporte <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
