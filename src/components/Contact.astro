<section
  id="contact"
  class="py-32 bg-primary-light/30 relative overflow-hidden"
>
  <!-- Decorative Elements -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-accent/10 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/2"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-primary/10 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/2"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-24" data-aos="fade-up">
      <h2
        class="text-5xl md:text-6xl font-serif font-bold text-primary-dark mb-6 italic"
      >
        Inicia tu Historia
      </h2>
      <p
        class="max-w-2xl mx-auto text-lg md:text-xl text-primary-dark/80 font-light leading-relaxed"
      >
        El lujo comienza con una conversación. Elige tu canal preferido y
        permítenos diseñar tu estancia perfecta.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- WHATSAPP CTA -->
      <div data-aos="fade-right">
        <div
          class="glass p-12 rounded-[40px] shadow-premium border border-white/40 bg-white/40 text-center lg:text-left"
        >
          <div
            class="w-20 h-20 bg-green-500 rounded-3xl flex items-center justify-center mb-8 mx-auto lg:mx-0 shadow-lg shadow-green-500/30"
          >
            <svg
              class="w-12 h-12 text-white"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.385-4.326 9.771-9.71 9.775z"
              ></path>
            </svg>
          </div>
          <h3
            class="text-4xl font-serif font-bold text-primary-dark mb-6 italic"
          >
            Atención Inmediata
          </h3>
          <p
            class="text-xl text-primary-dark/70 font-light mb-10 leading-relaxed"
          >
            Nuestro servicio de Concierge está disponible en WhatsApp para
            resolver cualquier duda al instante.
          </p>
          <a
            href="https://wa.me/50686544883"
            target="_blank"
            class="inline-flex items-center gap-4 bg-green-500 text-white px-10 py-6 rounded-2xl font-bold shadow-xl shadow-green-500/20 hover:bg-green-600 transition-all duration-300 hover:scale-105 uppercase tracking-widest text-sm"
          >
            <span>Hablar por WhatsApp</span>
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- FORMULARIO -->
      <div data-aos="fade-left">
        <form
          id="contact-form"
          class="glass p-10 rounded-[40px] shadow-premium border border-white/40"
        >
          <h3 class="text-2xl font-serif font-bold text-primary-dark mb-8">
            Escríbenos
          </h3>

          <input
            type="text"
            id="website"
            name="website"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />
          <p
            id="contact-status"
            class="hidden mb-6 p-4 rounded-2xl text-sm font-medium"
          >
          </p>

          <div class="space-y-6">
            <div class="space-y-2">
              <label
                for="contact-name"
                class="block text-xs font-bold text-primary-dark/40 uppercase tracking-widest ml-1"
                >Nombre Completo</label
              >
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Tu nombre aquí"
                class="w-full px-6 py-4 bg-white/50 border border-white/20 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all placeholder:text-primary-dark/20"
              />
            </div>

            <div class="space-y-2">
              <label
                for="contact-email"
                class="block text-xs font-bold text-primary-dark/40 uppercase tracking-widest ml-1"
                >Email de Contacto</label
              >
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="email@ejemplo.com"
                class="w-full px-6 py-4 bg-white/50 border border-white/20 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all placeholder:text-primary-dark/20"
              />
            </div>

            <div class="space-y-2">
              <label
                for="contact-message"
                class="block text-xs font-bold text-primary-dark/40 uppercase tracking-widest ml-1"
                >Tu Mensaje</label
              >
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                placeholder="Cuéntanos más sobre tus planes..."
                class="w-full px-6 py-4 bg-white/50 border border-white/20 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all placeholder:text-primary-dark/20 resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="contact-submit"
              class="w-full bg-primary text-primary-light px-8 py-5 rounded-2xl font-bold shadow-premium hover:bg-primary-dark transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-3"
            >
              <span>Enviar Mensaje</span>
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- SCRIPT para probar /api/contacto -->
<script type="module">
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("contact-submit");
  const statusEl = document.getElementById("contact-status");

  const show = (msg, ok = true) => {
    if (!statusEl) return;
    statusEl.classList.remove(
      "hidden",
      "bg-green-100",
      "text-green-800",
      "bg-red-100",
      "text-red-800",
    );
    statusEl.classList.add(ok ? "bg-green-100" : "bg-red-100");
    statusEl.classList.add(ok ? "text-green-800" : "text-red-800");
    statusEl.textContent = msg;
  };
  const hide = () => {
    if (statusEl) statusEl.classList.add("hidden");
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hide();

    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span>Enviando...</span><svg class="animate-spin h-5 w-5 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    const name = document.getElementById("contact-name")?.value?.trim() || "";
    const email = document.getElementById("contact-email")?.value?.trim() || "";
    const message =
      document.getElementById("contact-message")?.value?.trim() || "";
    const website = document.getElementById("website")?.value?.trim() || "";

    const [firstname, ...rest] = name.split(" ");
    const lastname = rest.join(" ");

    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          firstname,
          lastname,
          email,
          phone: "",
          message,
          website,
        }),
      });

      const json = await res.json();
      if (json?.success) {
        show("✅ ¡Mensaje enviado con éxito! Te contactaremos pronto.", true);
        form.reset();
      } else {
        show(
          json?.message ||
            "❌ No pudimos recibir tu mensaje. Intenta de nuevo.",
          false,
        );
      }
    } catch (err) {
      show("❌ Error de red. Por favor verifica tu conexión.", false);
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalContent;
    }
  });
</script>
