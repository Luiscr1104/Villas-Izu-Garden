            <!-- Quick Links -->
            <div class="md:col-span-3">
                <h4
                    class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-8 ml-1"
                >
                    Navegación
                </h4>
                <nav
                    class="flex flex-col space-y-4 font-light text-primary-light/80"
                >
                    <a
                        href="#about"
                        class="hover:text-primary transition-colors"
                        >La Historia</a
                    >
                    <a
                        href="#villas"
                        class="hover:text-primary transition-colors"
                        >Las Villas</a
                    >
                    <a
                        href="#amenities"
                        class="hover:text-primary transition-colors"
                        >Experiencias</a
                    >
                    <a
                        href="#availability"
                        class="hover:text-primary transition-colors">Reservas</a
                    >
                    <a
                        href="#contact"
                        class="hover:text-primary transition-colors"
                        >Privacidad</a
                    >
                </nav>
            </div>

            <!-- Contact column -->
            <div class="md:col-span-4">
                <h4
                    class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-8 ml-1"
                >
                    Suscripción
                </h4>
                <p class="text-primary-light/60 font-light mb-8">
                    Únete a nuestro círculo exclusivo para recibir novedades y
                    aperturas privadas.
                </p>
                <form class="relative group">
                    <input
                        type="email"
                        placeholder="tu@email.com"
                        class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 focus:outline-none focus:ring-2 focus:ring-primary/50 transition-all font-light placeholder:text-white/20"
                    />
                    <button
                        type="submit"
                        class="absolute right-2 top-2 bottom-2 bg-primary text-primary-light px-6 rounded-xl hover:bg-primary-dark transition-all duration-300 font-bold text-xs uppercase tracking-widest"
                    >
                        Unirse
                    </button>
                </form>
            </div>
        </div>

        <div
            class="mt-24 pt-10 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <p class="text-sm font-light text-primary-light/40">
                &copy; {new Date().getFullYear()} Villas Izu Garden. <span
                    class="hidden md:inline mx-2">|</span
                > Diseñado por <a
                    href="https://luisroberto.dev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-primary transition-colors border-b border-primary/20 hover:border-primary"
                    >luisroberto.dev</a
