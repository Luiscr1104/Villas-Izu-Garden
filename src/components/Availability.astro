---

---

<section id="availability" class="py-20 bg-[#FFF0DA]">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-serif font-bold text-[#796446] mb-4">
        Disponibilidad y Reservas
      </h2>
      <p class="max-w-2xl mx-auto text-lg text-[#796446]">
        Verifica la disponibilidad de nuestras villas y realiza tu reserva de
        manera fácil y segura.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 bg-white rounded-lg shadow-lg p-6">
        <div class="mb-6">
          <h3 class="text-xl font-bold text-[#796446] mb-4">
            Calendario de Disponibilidad
          </h3>
          <div class="bg-[#F1D09E]/20 p-4 rounded mb-4">
            <p class="text-[#796446]">
              <strong>Nota:</strong> Los días marcados en rojo no están disponibles.
            </p>
          </div>

          <div
            id="calendar-container"
            class="border border-[#C69349]/20 rounded-lg p-4 min-h-[400px]"
          >
            <!-- Calendar will be rendered here -->
            <div class="flex justify-between items-center mb-4">
              <button
                id="prev-month"
                class="p-2 text-[#796446] hover:bg-[#C69349]/10 rounded"
                >&lt;</button
              >
              <h4 id="month-year" class="text-lg font-bold text-[#796446]"></h4>
              <button
                id="next-month"
                class="p-2 text-[#796446] hover:bg-[#C69349]/10 rounded"
                >&gt;</button
              >
            </div>
            <div
              class="grid grid-cols-7 gap-2 text-center text-sm font-bold text-[#796446] mb-2"
            >
              <div>Dom</div><div>Lun</div><div>Mar</div><div>Mié</div><div>
                Jue
              </div><div>Vie</div><div>Sáb</div>
            </div>
            <div id="calendar-days" class="grid grid-cols-7 gap-2 text-center">
              <!-- Days -->
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-lg p-6">
        <h3 class="text-xl font-bold text-[#796446] mb-4">
          Realiza tu Reserva
        </h3>
        <form class="space-y-4">
          <!-- Simplified form for now, just to show intent -->
          <div>
            <label
              for="villa"
              class="block text-sm font-medium text-[#796446] mb-1"
              >Selecciona Villa</label
            >
            <select
              id="villa"
              name="villa"
              class="w-full px-3 py-2 border border-[#C69349]/20 rounded-md focus:outline-none focus:ring-2 focus:ring-[#C69349]/50"
            >
              <option value="">Selecciona una villa</option>
              <option value="sakura">Villa Sakura</option>
              <option value="zen">Villa Zen</option>
              <option value="harmony">Villa Harmony</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label
                for="checkin"
                class="block text-sm font-medium text-[#796446] mb-1"
                >Fecha de llegada</label
              >
              <input
                type="date"
                id="checkin"
                name="checkin"
                class="w-full px-3 py-2 border border-[#C69349]/20 rounded-md focus:outline-none focus:ring-2 focus:ring-[#C69349]/50"
              />
            </div>
            <div>
              <label
                for="checkout"
                class="block text-sm font-medium text-[#796446] mb-1"
                >Fecha de salida</label
              >
              <input
                type="date"
                id="checkout"
                name="checkout"
                class="w-full px-3 py-2 border border-[#C69349]/20 rounded-md focus:outline-none focus:ring-2 focus:ring-[#C69349]/50"
              />
            </div>
          </div>

          <div
            class="bg-yellow-50 p-3 rounded text-sm text-[#796446] border border-yellow-200"
          >
            Para confirmar disponibilidad real y reservar, por favor contáctanos
            directamente por WhatsApp.
          </div>

          <a
            href="https://wa.me/506YOURNUMBER"
            target="_blank"
            class="block w-full text-center bg-[#25D366] text-white py-3 rounded-md hover:bg-[#25D366]/90 transition-colors font-bold"
          >
            Reservar por WhatsApp
          </a>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  let currentDate = new Date();
  let blockedDates: string[] = [];

  async function fetchAvailability() {
    try {
      const res = await fetch("/api/availability");
      blockedDates = await res.json();
      renderCalendar();
    } catch (e) {
      console.error("Error fetching availability", e);
    }
  }

  function renderCalendar() {
    const monthYear = document.getElementById("month-year");
    const calendarDays = document.getElementById("calendar-days");

    if (!monthYear || !calendarDays) return;

    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    const monthNames = [
      "Enero",
      "Febrero",
      "Marzo",
      "Abril",
      "Mayo",
      "Junio",
      "Julio",
      "Agosto",
      "Septiembre",
      "Octubre",
      "Noviembre",
      "Diciembre",
    ];
    monthYear.textContent = `${monthNames[month]} ${year}`;

    calendarDays.innerHTML = "";

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    // Empty cells for previous month
    for (let i = 0; i < firstDay; i++) {
      const div = document.createElement("div");
      calendarDays.appendChild(div);
    }

    const today = new Date(); // Local today
    today.setHours(0, 0, 0, 0);

    for (let i = 1; i <= daysInMonth; i++) {
      const div = document.createElement("div");
      div.textContent = i.toString();
      div.className = "py-2 rounded text-center text-[#796446]";

      const checkDate = new Date(year, month, i);
      const dateString = checkDate.toISOString().split("T")[0];

      if (blockedDates.includes(dateString)) {
        div.classList.add("bg-red-200", "text-red-800", "cursor-not-allowed");
        div.title = "No disponible";
      } else if (checkDate.getTime() < today.getTime()) {
        div.classList.add("text-gray-300", "cursor-not-allowed");
      } else {
        div.classList.add("hover:bg-[#C69349]/20", "cursor-pointer");
      }

      calendarDays.appendChild(div);
    }
  }
  document.getElementById("prev-month")?.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });

  document.getElementById("next-month")?.addEventListener("click", () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });

  // Init
  fetchAvailability();
</script>
