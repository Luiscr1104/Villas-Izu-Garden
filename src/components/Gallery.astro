---
import gallery1 from "@/assets/gallery1.png";
import gallery2 from "@/assets/gallery2.png";
import gallery3 from "@/assets/gallery3.png";
import gallery4 from "@/assets/gallery4.png";
import gallery5 from "@/assets/gallery5.png";
---

<section id="gallery" class="py-32 bg-primary-dark relative overflow-hidden">
  <!-- Decorative Elements -->
  <div
    class="absolute top-0 left-0 w-64 h-64 bg-primary/10 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Título -->
    <div class="text-center mb-24" data-aos="fade-up">
      <h2
        class="text-5xl md:text-6xl font-serif font-bold text-primary-light mb-6 italic"
      >
        Fragmentos de Paz
      </h2>
      <p
        class="max-w-2xl mx-auto text-lg md:text-xl text-primary-light/60 font-light leading-relaxed"
      >
        Cada rincón de Villas Izu Garden es una invitación a la contemplación y
        el asombro.
      </p>
    </div>

    <!-- Galería de imágenes -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        [
          {
            src: gallery1,
            alt: "Fachada Villa Sakura - Lujo en La Fortuna",
            text: "Villa Sakura",
          },
          {
            src: gallery2,
            alt: "Piscina Infinity con Vistas al Volcán Arenal",
            text: "Piscina Infinita",
          },
          {
            src: gallery3,
            alt: "Interior Moderno y Minimalista de Villa Zen",
            text: "Sala de Estar",
          },
          {
            src: gallery4,
            alt: "Suite Principal con Cama King y Vistas Panorámicas",
            text: "Suite Principal",
          },
          {
            src: gallery5,
            alt: "Platillos de Alta Cocina en Izu Garden",
            text: "Haute Cuisine",
          },
          { src: gallery1, alt: "Spa", text: "Spa Zen" },
        ].map((item, i) => (
          <div
            class="relative group overflow-hidden rounded-[40px] shadow-premium aspect-[4/5]"
            data-aos="zoom-in"
            data-aos-delay={`${i * 100}`}
          >
            <img
              src={item.src.src}
              alt={item.alt}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-10">
              <span class="text-primary font-bold uppercase tracking-[0.2em] text-[10px] mb-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                Izu Garden Gallery
              </span>
              <p class="text-white font-serif font-bold text-2xl italic translate-y-4 group-hover:translate-y-0 transition-transform duration-700 delay-75">
                {item.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="text-center mt-20" data-aos="fade-up">
      <a
        href="https://instagram.com/villasizugarden"
        target="_blank"
        class="inline-flex items-center gap-3 glass px-10 py-5 rounded-full text-primary-light font-bold uppercase tracking-widest text-xs hover:bg-white/10 transition-all duration-300"
      >
        Seguir en Instagram
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
          ><path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</section>
