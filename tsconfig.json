{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/env.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client", "node"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
